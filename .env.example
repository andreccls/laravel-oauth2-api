# DEV-ONLY values. Never use them in a real environment. Copy to .env (git-ignored) if you run outside Docker.
APP_NAME="Laravel OAuth2 API"
APP_ENV=local
APP_KEY=base64:ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
APP_DEBUG=true
APP_URL=http://localhost:8088

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3318
DB_DATABASE=oauth2_api
DB_USERNAME=oauth2
DB_PASSWORD=dev_only_db_password

CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6389

# Passport keys live in storage/oauth-*.key (generated by `make keys`, git-ignored).
# Alternatively set PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY.

API_RATE_LIMIT=120
API_ACCESS_TOKEN_TTL_MINUTES=60
API_REFRESH_TOKEN_TTL_DAYS=14

# Host ports used by docker-compose.yml
API_PORT=8088
FPM_PORT=8089
MYSQL_PORT=3318
REDIS_PORT=6389
