{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "andreccls/laravel-oauth2-api",
    "type": "project",
    "description": "Reference OAuth2 API: Laravel + Passport + Octane (RoadRunner) + Redis. Example project, not a product.",
    "keywords": [
        "laravel",
        "oauth2",
        "passport",
        "octane",
        "api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.20",
        "laravel/passport": "^13.8",
        "laravel/tinker": "^3.0",
        "spiral/roadrunner-http": "^4.1"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.47",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
